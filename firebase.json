{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "web-checkin/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "**", "destination": "/index.html"}
    ],
    "predeploy": ["npm --prefix web-checkin run build"]
  },
  "emulators": {
    "auth": {"port": 9099},
    "firestore": {"port": 8080},
    "hosting": {"port": 5000},
    "ui": {"enabled": true}
  }
}
