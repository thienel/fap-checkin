rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }

    function isGoogleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string;
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data;
    }

    function sessionDataAfter(sessionId) {
      return getAfter(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data;
    }

    function tokenData(token) {
      return get(/databases/$(database)/documents/qrTokens/$(token)).data;
    }

    function studentData(courseClassId, studentId) {
      return get(/databases/$(database)/documents/courseClasses/$(courseClassId)/students/$(studentId)).data;
    }

    // A student submits the checkout code with the attendance write. Rules
    // compare it against the private, current code without granting students
    // read access to attendanceCheckoutCodes.
    function validStudentCheckIn(courseClassId, slotKey, studentId) {
      let attendance = request.resource.data;
      let student = studentData(courseClassId, studentId);
      let session = sessionData(attendance.sessionId);
      let qr = tokenData(attendance.qrToken);
      let checkout = get(/databases/$(database)/documents/attendanceCheckoutCodes/$(attendance.sessionId)).data;
      return isGoogleUser()
        && attendance.keys().hasOnly([
          'ownerUid', 'firebaseUid', 'studentId', 'email', 'emailNormalized',
          'studentCode', 'fullName', 'sessionId', 'courseClassId', 'subject',
          'classCode', 'slot', 'slotKey', 'date', 'qrToken', 'checkoutCode',
          'checkedInAt', 'createdAt', 'updatedAt', 'updatedBy', 'syncStatus',
          'attendanceStatus', 'recordSource'
        ])
        && attendance.studentId == studentId
        && attendance.courseClassId == courseClassId
        && attendance.slotKey == slotKey
        && attendance.firebaseUid == request.auth.uid
        && attendance.updatedBy == request.auth.uid
        && attendance.emailNormalized == request.auth.token.email
        && student.emailNormalized == request.auth.token.email
        && student.active == true
        && attendance.email == student.email
        && attendance.studentCode == student.studentCode
        && attendance.fullName == student.fullName
        && attendance.sessionId is string
        && session.ownerUid == attendance.ownerUid
        && session.courseClassId == courseClassId
        && session.subject == attendance.subject
        && session.classCode == attendance.classCode
        && session.slot == attendance.slot
        && session.slotKey == slotKey
        && session.date == attendance.date
        && session.status == 'active'
        && qr.sessionId == attendance.sessionId
        && qr.ownerUid == session.ownerUid
        && qr.issuedAt is timestamp
        && qr.validitySeconds is int
        && qr.validitySeconds >= 2
        && qr.validitySeconds <= 120
        && request.time <= qr.issuedAt
          + duration.value(qr.validitySeconds, 's')
        && qr.qrGeneration is int
        && session.currentQrGeneration is int
        && qr.qrGeneration <= session.currentQrGeneration
        && qr.validitySeconds == session.validitySeconds
        && attendance.checkoutCode is string
        && attendance.checkoutCode.matches('^[A-Z0-9]{5}$')
        && checkout.ownerUid == session.ownerUid
        && checkout.sessionId == attendance.sessionId
        && checkout.code == attendance.checkoutCode
        && checkout.rotationSeconds is int
        && checkout.rotationSeconds >= 10
        && checkout.rotationSeconds <= 3600
        && checkout.issuedAt is timestamp
        && request.time <= checkout.issuedAt
          + duration.value(checkout.rotationSeconds, 's')
          + duration.value(3, 's')
        && attendance.checkedInAt == request.time
        && attendance.createdAt == request.time
        && attendance.updatedAt == request.time
        && attendance.syncStatus == 'pending'
        && attendance.attendanceStatus == 'present'
        && attendance.recordSource == 'qr';
    }

    function ownsCourse(courseClassId) {
      return isTeacher()
        && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
          == request.auth.uid;
    }

    match /teachers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /courseClasses/{courseClassId} {
      // Creating a course-class first reads its deterministic ID to detect a
      // duplicate. A missing document has no resource.data, so allow that
      // not-found read explicitly for authenticated teachers.
      allow get: if isTeacher()
        && (
          !exists(/databases/$(database)/documents/courseClasses/$(courseClassId))
          || resource.data.ownerUid == request.auth.uid
        );
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'subject', 'classCode', 'startDate', 'slotCount', 'weekLabel',
          'schedule', 'ownerUid', 'createdAt'
        ])
        && request.resource.data.createdAt == request.time;
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      match /students/{studentId} {
        // Student IDs are derived from email and can be guessed. A direct
        // lookup must also belong to the signed-in Google account.
        allow get: if (isGoogleUser()
            && resource.data.emailNormalized == request.auth.token.email)
          || (isTeacher()
            && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
              == request.auth.uid);
        allow list: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid;
        allow create, update: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid
          && request.resource.data.emailNormalized is string
          && request.resource.data.email is string
          && request.resource.data.studentCode is string
          && request.resource.data.studentCodeNormalized is string
          && request.resource.data.fullName is string
          && request.resource.data.active is bool
          && request.resource.data.attendancePolicy in ['normal', 'alwaysExcused']
          && request.resource.data.importedBy == request.auth.uid;
        allow delete: if false;
      }

      // Task 1.1: studentCodeClaims enforce MSSV uniqueness khi concurrent writes.
      // Chỉ course owner mới được tạo/cập nhật claim; không cho đổi sang studentId khác.
      match /studentCodeClaims/{studentCode} {
        allow read: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid;
        allow create: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.studentId is string
          && request.resource.data.keys().hasOnly(['studentId', 'ownerUid', 'createdAt']);
        allow update: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          // Không cho thay đổi studentId – phải migration explicit nếu đổi MSSV.
          && request.resource.data.studentId == resource.data.studentId;
        allow delete: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid;
      }

      match /imports/{importId} {
        allow read: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid;
        allow create: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /activeAttendanceSessions/{uid} {
      allow get: if isTeacher() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isTeacher()
        && request.auth.uid == uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'sessionId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && sessionDataAfter(request.resource.data.sessionId).ownerUid == request.auth.uid;
      allow delete: if isTeacher() && request.auth.uid == uid;
    }

    match /attendanceSessions/{sessionId} {
      allow get: if (isTeacher() && resource.data.ownerUid == request.auth.uid)
        || (isGoogleUser() && resource.data.status == 'active');
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt == request.time
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'courseClassId', 'subject', 'classCode', 'slot',
          'slotKey', 'date', 'rotationSeconds', 'validitySeconds', 'status',
          'startedAt'
        ]);
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // The checkout code is private to teachers and the check-in callable.
    // Students submit it to the callable, which validates it server-side.
    match /attendanceCheckoutCodes/{sessionId} {
      allow get: if isTeacher()
        && (
          !exists(/databases/$(database)/documents/attendanceCheckoutCodes/$(sessionId))
          || resource.data.ownerUid == request.auth.uid
        );
      allow list: if false;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9]{5}$')
        && request.resource.data.rotationSeconds is int
        && request.resource.data.rotationSeconds >= 10
        && request.resource.data.rotationSeconds <= 3600
        && request.resource.data.generation == 1
        && request.resource.data.issuedAt == request.time
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'sessionId', 'code', 'rotationSeconds',
          'generation', 'issuedAt'
        ])
        && sessionDataAfter(sessionId).ownerUid == request.auth.uid
        && sessionDataAfter(sessionId).status == 'active';
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.sessionId == sessionId
        && sessionData(sessionId).status == 'active'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9]{5}$')
        && request.resource.data.rotationSeconds == resource.data.rotationSeconds
        && request.resource.data.generation == resource.data.generation + 1
        && request.resource.data.issuedAt == request.time
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'sessionId', 'code', 'rotationSeconds',
          'generation', 'issuedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'code', 'generation', 'issuedAt'
        ]);
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;
    }

    match /qrTokens/{token} {
      allow get: if (isTeacher() && resource.data.ownerUid == request.auth.uid)
        || (isGoogleUser()
          && resource.data.issuedAt is timestamp
          && resource.data.validitySeconds is int
          && resource.data.validitySeconds >= 2
          && resource.data.validitySeconds <= 120
          && request.time <= resource.data.issuedAt
            + duration.value(resource.data.validitySeconds, 's'));
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'sessionId', 'issuedAt', 'validitySeconds', 'qrGeneration'
        ])
        && request.resource.data.issuedAt == request.time
        && request.resource.data.validitySeconds is int
        && request.resource.data.validitySeconds >= 2
        && request.resource.data.validitySeconds <= 120
        && request.resource.data.qrGeneration is int
        && sessionDataAfter(request.resource.data.sessionId).ownerUid == request.auth.uid
        && sessionDataAfter(request.resource.data.sessionId).status == 'active'
        // Task 1.3: Token phải thuộc đúng generation hiện tại của session.
        && request.resource.data.qrGeneration
          == sessionDataAfter(request.resource.data.sessionId).currentQrGeneration
        && request.resource.data.validitySeconds
          == sessionDataAfter(request.resource.data.sessionId).validitySeconds;
      allow update: if false;
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;
    }

    match /attendance/{courseClassId}/slots/{slotKey}/checkIns/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId
          || ownsCourse(courseClassId));
      // The course ID is fixed by this collection path, so ownership can be
      // proven from the parent course without constraining every teacher query
      // by a record field. This enables slot overview and realtime roster reads.
      allow list: if ownsCourse(courseClassId);
      // Task 1.3: Block mọi create mới vào legacy checkIns sau migration.
      // Giữ get/list/update tạm thời cho transition period.
      allow create: if false;
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'syncStatus', 'syncedAt', 'syncError'
        ]);
      allow delete: if false;
    }

    // Canonical attendance state. There is exactly one final record per
    // student and slot; QR, teacher edits and policy materialization all
    // converge here. Legacy checkIns above remain readable during migration.
    match /attendance/{courseClassId}/slots/{slotKey}/records/{studentId} {
      allow get: if ownsCourse(courseClassId)
        || (isGoogleUser()
          && studentData(courseClassId, studentId).emailNormalized
            == request.auth.token.email);
      allow list: if ownsCourse(courseClassId);

      // Students can create their own canonical record only when the current
      // QR and private checkout code both validate at write time.
      allow create: if validStudentCheckIn(courseClassId, slotKey, studentId);

      // Branch giảng viên/policy: chỉ teacher có thể create/update với mọi status.
      // Sinh viên hoàn toàn không được update hoặc delete record của mình.
      allow create, update: if ownsCourse(courseClassId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.studentId == studentId
        && request.resource.data.courseClassId == courseClassId
        && request.resource.data.slotKey == slotKey
        && request.resource.data.attendanceStatus in ['present', 'absent', 'excused']
        && request.resource.data.recordSource in ['qr', 'teacher', 'policy'];
      allow delete: if false;

      match /audit/{auditId} {
        allow read: if ownsCourse(courseClassId);
        allow create: if ownsCourse(courseClassId)
          && request.resource.data.changedBy == request.auth.uid
          && request.resource.data.changedAt == request.time
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 3;
        allow update, delete: if false;
      }
    }

    // Desktop uses collectionGroup('checkIns') to count and sync attendance.
    // Collection-group queries need a recursive wildcard rule because they can
    // target a checkIns collection at any document depth.
    match /{path=**}/checkIns/{userId} {
      allow list: if isTeacher()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'syncStatus', 'syncedAt', 'syncError'
        ]);
    }

    match /{path=**}/records/{studentId} {
      allow list: if isTeacher()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'syncStatus', 'syncedAt', 'syncError'
        ]);
    }

    // Task 1.2: teacherScheduleLocks – prevent giảng viên chiếm cùng slot.
    // Lock ID: {ownerUid}_{date}_{daySlot}. Chỉ owner mới được tạo/xóa lock của mình.
    match /teacherScheduleLocks/{lockId} {
      // Teachers must be able to check an unoccupied deterministic lock ID.
      allow get: if isTeacher()
        && (
          !exists(/databases/$(database)/documents/teacherScheduleLocks/$(lockId))
          || resource.data.ownerUid == request.auth.uid
        );
      allow list: if isTeacher()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'date', 'daySlot', 'courseClassId',
          'subject', 'classCode', 'slotNumber', 'createdAt'
        ]);
      allow delete: if isTeacher()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
