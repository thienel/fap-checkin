rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data;
    }

    function sessionDataAfter(sessionId) {
      return getAfter(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data;
    }

    function studentData(courseClassId, studentId) {
      return get(/databases/$(database)/documents/courseClasses/$(courseClassId)/students/$(studentId)).data;
    }

    function ownsCourse(courseClassId) {
      return isTeacher()
        && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
          == request.auth.uid;
    }

    match /teachers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /courseClasses/{courseClassId} {
      allow get: if isTeacher()
        && (
          !exists(/databases/$(database)/documents/courseClasses/$(courseClassId))
          || resource.data.ownerUid == request.auth.uid
        );
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'subject', 'classCode', 'startDate', 'slotCount', 'weekLabel',
          'schedule', 'ownerUid', 'createdAt'
        ])
        && request.resource.data.createdAt == request.time;
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      match /students/{studentId} {
        // Cho phép tra cứu thông tin 1 sinh viên trong danh sách để validate form
        allow get: if true;
        allow list: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid;
        allow create, update: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid
          && request.resource.data.emailNormalized is string
          && request.resource.data.email is string
          && request.resource.data.studentCode is string
          && request.resource.data.fullName is string
          && request.resource.data.active is bool
          && request.resource.data.attendancePolicy in ['normal', 'alwaysExcused']
          && request.resource.data.importedBy == request.auth.uid;
        allow delete: if false;
      }

      match /imports/{importId} {
        allow read: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid;
        allow create: if isTeacher()
          && get(/databases/$(database)/documents/courseClasses/$(courseClassId)).data.ownerUid
            == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /activeAttendanceSessions/{uid} {
      allow get: if isTeacher() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isTeacher()
        && request.auth.uid == uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'sessionId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && sessionDataAfter(request.resource.data.sessionId).ownerUid == request.auth.uid;
      allow delete: if isTeacher() && request.auth.uid == uid;
    }

    match /attendanceSessions/{sessionId} {
      // Cho phép lấy thông tin phiên điểm danh nếu phiên đang active
      allow get: if (isTeacher() && resource.data.ownerUid == request.auth.uid)
        || (resource.data.status == 'active');
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt == request.time
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'courseClassId', 'subject', 'classCode', 'slot',
          'slotKey', 'date', 'rotationSeconds', 'validitySeconds', 'status',
          'startedAt', 'checkoutKey', 'previousCheckoutKey', 'checkoutKeyUpdatedAt'
        ]);
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /qrTokens/{token} {
      // Cho phép tra cứu token QR nếu phiên điểm danh đang active
      allow get: if (isTeacher() && resource.data.ownerUid == request.auth.uid)
        || sessionData(resource.data.sessionId).status == 'active';
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'sessionId', 'issuedAt', 'validitySeconds', 'qrGeneration'
        ])
        && request.resource.data.issuedAt == request.time
        && request.resource.data.validitySeconds is int
        && request.resource.data.validitySeconds >= 2
        && request.resource.data.validitySeconds <= 120
        && sessionData(request.resource.data.sessionId).ownerUid == request.auth.uid
        && sessionData(request.resource.data.sessionId).status == 'active'
        && request.resource.data.validitySeconds
          == sessionData(request.resource.data.sessionId).validitySeconds;
      allow update: if false;
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;
    }

    match /attendance/{courseClassId}/slots/{slotKey}/checkIns/{userId} {
      allow get, list, create, update, delete: if false;
    }

    match /attendance/{courseClassId}/slots/{slotKey}/records/{studentId} {
      allow get: if true;
      allow list: if ownsCourse(courseClassId);
      // Ghi nhận điểm danh khi sinh viên tự điền form
      allow create: if request.resource.data.studentId == studentId
        && studentData(courseClassId, studentId).get('active', true) != false
        && studentData(courseClassId, studentId).emailNormalized
          == request.resource.data.emailNormalized
        && request.resource.data.studentCode.upper()
          == studentData(courseClassId, studentId).studentCode.upper()
        && request.resource.data.courseClassId == courseClassId
        && request.resource.data.slotKey == slotKey
        && request.resource.data.attendanceStatus == 'present'
        && request.resource.data.recordSource == 'qr'
        && request.resource.data.checkedInAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.syncStatus == 'pending'
        && sessionData(request.resource.data.sessionId).status == 'active'
        && request.resource.data.ownerUid
          == sessionData(request.resource.data.sessionId).ownerUid
        && request.resource.data.courseClassId
          == sessionData(request.resource.data.sessionId).courseClassId
        && request.resource.data.subject
          == sessionData(request.resource.data.sessionId).subject
        && request.resource.data.classCode
          == sessionData(request.resource.data.sessionId).classCode
        && request.resource.data.slot
          == sessionData(request.resource.data.sessionId).slot
        && request.resource.data.slotKey
          == sessionData(request.resource.data.sessionId).slotKey
        && request.resource.data.date
          == sessionData(request.resource.data.sessionId).date
        && request.resource.data.qrToken is string
        && request.resource.data.checkoutKey is string
        && (request.resource.data.checkoutKey.upper() == sessionData(request.resource.data.sessionId).checkoutKey.upper() 
            || request.resource.data.checkoutKey.upper() == sessionData(request.resource.data.sessionId).get('previousCheckoutKey', 'invalid_no_match').upper());

      allow create, update: if ownsCourse(courseClassId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.studentId == studentId
        && request.resource.data.courseClassId == courseClassId
        && request.resource.data.slotKey == slotKey
        && request.resource.data.attendanceStatus in ['present', 'absent', 'excused']
        && request.resource.data.recordSource in ['qr', 'teacher', 'policy'];
      allow delete: if false;

      match /audit/{auditId} {
        allow read: if ownsCourse(courseClassId);
        allow create: if ownsCourse(courseClassId)
          && request.resource.data.changedBy == request.auth.uid
          && request.resource.data.changedAt == request.time
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 3;
        allow update, delete: if false;
      }
    }

    match /{path=**}/checkIns/{userId} {
      allow list: if isTeacher()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'syncStatus', 'syncedAt', 'syncError'
        ]);
    }

    match /{path=**}/records/{studentId} {
      allow list: if isTeacher()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'syncStatus', 'syncedAt', 'syncError'
        ]);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
